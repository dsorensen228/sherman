#!/bin/sh
# Independent stationary banter; never owns display, camera, or motors.
set -eu
APP=${SHERMAN_BANTER_APP:-/opt/sherman-banter/banter/run_banter.py}
CONFIG=${SHERMAN_BANTER_CONFIG:-/etc/sherman/banter.json}
PID=${SHERMAN_BANTER_PID:-/run/sherman-banter.pid}
running() {
    [ -f "$PID" ] || return 1
    pid=$(cat "$PID")
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
    tr '\000' '\n' <"/proc/$pid/cmdline" 2>/dev/null | grep -Fqx "$APP"
}
case "${1:-}" in
    start)
        if running; then exit 0; fi
        /usr/bin/python3 "$APP" --config "$CONFIG" --check
        start-stop-daemon -S -b -m -p "$PID" -x /usr/bin/python3 -- "$APP" --config "$CONFIG"
        sleep 1
        running
        ;;
    stop)
        if running; then
            # Wait through one bounded network call, then terminate if necessary.
            start-stop-daemon -K -p "$PID" -x /usr/bin/python3 -s TERM || true
            count=0
            while running && [ "$count" -lt 65 ]; do
                sleep 1
                count=$((count + 1))
            done
            if running; then
                start-stop-daemon -K -p "$PID" -x /usr/bin/python3 -s KILL || true
            fi
            rm -f "$PID"
        fi
        ;;
    restart) "$0" stop; "$0" start ;;
    status) running ;;
    *) echo "usage: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac
